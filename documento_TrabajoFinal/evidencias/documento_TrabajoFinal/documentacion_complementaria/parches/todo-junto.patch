-    printk("%d %s %s", p->pid, state, p->name);
+    printk("%d %s %s prio=%d/%d aff=0x%x cpu=%d", p->pid, state, p->name,
+           p->priority, p->eff_priority, p->affinity, p->last_cpu);
     printk("\n");
   }
 }
